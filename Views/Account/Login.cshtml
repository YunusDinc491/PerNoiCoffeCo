@{
    ViewData["Title"] = "Yönetici Girişi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetici Girişi - Per Noi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <style>
            html, body {
                height: 100%;
            }

            body {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
                background: radial-gradient(circle at 50% 20%, #2a1c14 0%, #150d09 55%, #0e0806 100%);
                overflow: hidden;
                position: relative;
            }

            .glow {
                position: absolute;
                width: 480px;
                height: 480px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(212,163,74,0.28) 0%, rgba(212,163,74,0) 70%);
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                pointer-events: none;
            }

            .steam-deco {
                position: absolute;
                top: -40px;
                right: 6%;
                width: 220px;
                opacity: 0.14;
                pointer-events: none;
            }

            .login-wrap {
                position: relative;
                z-index: 1;
                width: 100%;
                max-width: 380px;
                padding: 0 1rem;
            }

            .login-brand {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                justify-content: center;
                margin-bottom: 1.6rem;
            }

                .login-brand svg {
                    width: 26px;
                    height: 26px;
                    color: var(--gold, #d4a34a);
                }

                .login-brand span {
                    font-family: 'Fraunces', serif;
                    font-size: 1.15rem;
                    color: #f5ede1;
                    letter-spacing: 0.01em;
                }

            .login-card {
                background: linear-gradient(160deg, #241811 0%, #1a120d 100%);
                border: 1px solid rgba(212,163,74,0.25);
                border-radius: 18px;
                padding: 2.2rem 2rem;
                box-shadow: 0 20px 60px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.02) inset;
            }

                .login-card h1 {
                    margin: 0 0 .35rem;
                    font-family: 'Fraunces', serif;
                    font-size: 1.6rem;
                    color: #f5ede1;
                }

                .login-card .sub {
                    margin-bottom: 1.6rem;
                    color: rgba(245,237,225,0.6);
                    font-size: 0.88rem;
                    line-height: 1.4;
                }

            .login-error {
                background: rgba(220,80,60,.15);
                border: 1px solid #c0483a;
                color: #e8998c;
                padding: .6rem .8rem;
                border-radius: 8px;
                margin-bottom: 1.1rem;
                font-size: .85rem;
            }

            .login-card .field label {
                display: block;
                font-size: 0.78rem;
                font-weight: 600;
                color: rgba(245,237,225,0.75);
                margin-bottom: 0.4rem;
                letter-spacing: 0.02em;
                text-transform: uppercase;
            }

            .login-card .field {
                margin-bottom: 1.1rem;
            }

            .login-card input {
                width: 100%;
                box-sizing: border-box;
                background: #150d09;
                border: 1px solid rgba(212,163,74,0.22);
                border-radius: 9px;
                padding: 0.7rem 0.85rem;
                font-size: 0.92rem;
                color: #f5ede1;
                font-family: inherit;
                transition: border-color .2s ease, box-shadow .2s ease;
            }

                .login-card input::placeholder {
                    color: rgba(245,237,225,0.35);
                }

                .login-card input:focus {
                    outline: none;
                    border-color: var(--gold, #d4a34a);
                    box-shadow: 0 0 0 3px rgba(212,163,74,0.18);
                }

                /* Chrome/Edge otomatik doldurma rengini ez */
                .login-card input:-webkit-autofill,
                .login-card input:-webkit-autofill:hover,
                .login-card input:-webkit-autofill:focus {
                    -webkit-box-shadow: 0 0 0px 1000px #150d09 inset !important;
                    -webkit-text-fill-color: #f5ede1 !important;
                    caret-color: #f5ede1;
                    transition: background-color 9999s ease-in-out 0s;
                }

            .login-divider {
                height: 1px;
                background: rgba(212,163,74,0.15);
                margin: 1.4rem 0 1.3rem;
            }

            .login-submit {
                width: 100%;
                padding: 0.75rem 1rem;
                border-radius: 9px;
                border: none;
                background: linear-gradient(160deg, #e0b86a, #c98f34);
                color: #241811;
                font-weight: 700;
                font-size: 0.92rem;
                cursor: pointer;
                transition: transform .15s ease, box-shadow .15s ease;
            }

                .login-submit:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 8px 22px rgba(212,163,74,0.32);
                }

            .login-foot {
                text-align: center;
                margin-top: 1.4rem;
                font-size: 0.78rem;
                color: rgba(245,237,225,0.35);
            }
    </style>
</head>
<body>
    <div class="glow"></div>
    <svg class="steam-deco" viewBox="0 0 340 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M120 90c-10 12 10 18 0 32s10 20 0 32" stroke="#d4a34a" stroke-width="3" stroke-linecap="round" />
        <path d="M170 90c-10 12 10 18 0 32s10 20 0 32" stroke="#d4a34a" stroke-width="3" stroke-linecap="round" />
        <path d="M220 90c-10 12 10 18 0 32s10 20 0 32" stroke="#d4a34a" stroke-width="3" stroke-linecap="round" />
    </svg>

    <div class="login-wrap">
        <div class="login-brand">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M16 4C11 4 8 8.5 8 13c0 5.5 3.6 10 8 15 4.4-5 8-9.5 8-15 0-4.5-3-9-8-9Z" stroke="currentColor" stroke-width="1.6" />
                <path d="M12 13c1.5 1.8 6.5 1.8 8 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span>Per Noi Admin</span>
        </div>

        <div class="login-card">
            <h1>Yönetici Girişi</h1>
            <div class="sub">Devam etmek için yönetici hesabınla giriş yap.</div>

            @if (ViewBag.Hata != null)
            {
                <div class="login-error">@ViewBag.Hata</div>
            }

            <form method="post" asp-controller="Account" asp-action="Login">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label>Kullanıcı Adı</label>
                    <input type="text" name="kullaniciAdi" placeholder="Kullanıcı adını gir" required autofocus autocomplete="username" />
                </div>
                <div class="field">
                    <label>Şifre</label>
                    <input type="password" name="sifre" placeholder="••••••••" required autocomplete="current-password" />
                </div>
                <div class="login-divider"></div>
                <button type="submit" class="login-submit">Giriş Yap</button>
            </form>
        </div>

        <div class="login-foot">Per Noi Coffee Co. &middot; Yönetim Paneli</div>
    </div>
</body>
</html>