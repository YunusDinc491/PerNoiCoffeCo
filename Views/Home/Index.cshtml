@model List<PerNoiWebsite.Models.Menu>
@{
    Layout = null;
}

<title>PerNoi Coffee Co.</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Karla:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/css/PerNoi.css" asp-append-version="true" />
<div class="hero-bg"></div>
<header class="site">
    <nav class="nav">
        <a class="brand" href="#top">
            <<img class="brand-mark" src="~/images/genel/logo.png" alt="Per Noi logo">
            <span class="brand-name">Per Noi Coffee Co.</span>
        </a>
        <ul class="nav-links" id="navLinks">
            <li><a href="#hakkimizda">Hikayemiz</a></li>
            <li><a href="#menu">Menü</a></li>
            <li><a href="#galeri">Galeri</a></li>
            <li><a href="#urunler">Ürünler</a></li>
            <li><a href="#rezervasyon">Rezervasyon</a></li>
        </ul>
        
        <a class="btn btn-solid nav-cta" href="#rezervasyon">Masa Ayırt</a>
        <a class="btn btn-ghost nav-cta" asp-controller="Account" asp-action="Login">Yönetici Giriş</a> 
        <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="Menüyü aç/kapat">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
    </nav>
</header>

<main id="top">

    <!-- Hero -->
    <section class="hero">
        <div class="wrap">
            <div class="hero-copy">
                <span class="eyebrow">Ortaköy · 2022'dan beri</span>
                <h1>Her yudumda <em>sıcak</em> bir mola</h1>
                <p class="hero-sub measure">Kendi kavurduğumuz çekirdekler, el yapımı tatlılar ve komşu sohbetleri için ayrılmış bir köşe. Sabah ilk kahveden akşam son tatlıya kadar kapımız açık.</p>
                <div class="hero-actions">
                    <a class="btn btn-solid" href="#menu">Menüyü Gör</a>
                    <a class="btn btn-ghost" href="#rezervasyon">Rezervasyon Yap</a>
                </div>
                <div class="hero-stats">
                    <div><span class="num">6</span><span class="lbl">Yıllık Tecrübe</span></div>
                    <div><span class="num">15000+</span><span class="lbl">Mutlu Müşteri</span></div>
                    <div><span class="num">240+</span><span class="lbl">Günlük Misafir</span></div>
                </div>
            </div>
            <div class="hero-art">
                <img class="hero-art-photo" src="~/images/hero/kahve-firlama.png" alt="Kahve fincanı">
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="about" id="hakkimizda">
        <div class="wrap">
            <div class="about-art"><img src="~/images/genel/logo.png" alt="Per Noi Coffee & Dessert logosu"></div>
            <div class="about-copy">
                <span class="eyebrow">Hikayemiz</span>
                <h2 style="margin-top:0.7rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem);">@(ViewBag.Hikaye?.UstBaslik ?? "Bir komşu fırınının üstünde başladı")</h2>
                <p class="measure" style="margin-top:1.1rem; color: var(--ink-soft);">@(ViewBag.Hikaye?.AltMetin ?? "Demlik, 2016'da küçük bir kavurma makinesi ve on masayla açıldı...")</p>
                <p class="about-quote">"@(ViewBag.Hikaye?.OzluSoz ?? "Kahveyi hızlandırmıyoruz, sohbeti yavaşlatıyoruz.")"</p>
            </div>
        </div>
    </section>

    <!-- Menu -->
    <div class="mg-bg-wrap">
<div class="mg-bg">
    <div class="mg-bg-half" style="background-image:url('/images/menu/foto1.jpg');"></div>
    <div class="mg-bg-half" style="background-image:url('/images/menu/foto2.jpg');"></div>
</div>
    <section class="menu" id="menu">
        <div class="wrap">
            <div class="menu-head">
                <span class="eyebrow">Menü</span>
                <h2>Bugün ne için uğradınız?</h2>
            </div>
                        <div class="menu-grid">
                @foreach (var kategori in Model)
                {
                    <div class="menu-col">
                        <h3>@kategori.Baslik</h3>

                        @if (kategori.CaylarVeDigerleri != null)
                        {
                            @foreach (var item in kategori.CaylarVeDigerleri)
                            {
                                <div class="menu-item">
                                    <div class="menu-item-row"><span class="name">@item.IcecekAdi</span><span class="dots"></span><span class="price">₺@item.Fiyat</span></div>
                                    <p class="desc">@item.Aciklama</p>
                                </div>
                            }
                        }
                    </div>
                }
                
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="gallery" id="galeri">
        <div class="wrap">
            <div class="menu-head">
                <span class="eyebrow">Galeri</span>
                <h2>Mekândan kareler</h2>
            </div>
                        @{
                var galeriListesi = (List<PerNoiWebsite.Models.Galeri>)ViewBag.Galeriler;
                var animasyonSuresi = Math.Max(galeriListesi.Count * 4, 12);
            }
            <div class="gallery-marquee">
                <div class="gallery-track" style="animation-duration: @(animasyonSuresi)s;">
                    @for (int tur = 0; tur < 2; tur++)
                    {
                        @foreach (var item in galeriListesi)
                        {
                            <figure class="gallery-card" style="background-image:url('@item.Foto');">
                                <figcaption>@item.Baslik</figcaption>
                            </figure>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
    </div>
        <!-- Ürünler -->
        <div class="mg-bg-wrap">
<div class="mg-bg">
    <div class="mg-bg-half" style="background-image:url('/images/urunler/foto1.jpg');"></div>
    <div class="mg-bg-half" style="background-image:url('/images/urunler/foto2.jpg');"></div>
</div>
    <section class="urunler" id="urunler">
        <div class="wrap">
            <div class="menu-head">
                <span class="eyebrow">Ürünler</span>
                <h2>Öne çıkanlar</h2>
            </div>
            @{
                var urunListesi = (List<PerNoiWebsite.Models.Urun>)ViewBag.Urunler;
                var urunAnimasyonSuresi = Math.Max(urunListesi.Count * 4, 12);
            }
            <div class="urunler-marquee">
                <div class="urunler-track" style="animation-duration: @(urunAnimasyonSuresi)s;">
                    @for (int tur = 0; tur < 2; tur++)
                    {
                        @foreach (var item in urunListesi)
                        {
                            <div class="urun-card">
                                <div class="urun-face" style="background-image:url('@item.Foto');">
                                    <div class="urun-name">@item.UrunAdi</div>
                                </div>
                                <div class="urun-info">
                                    <div class="urun-info-name">@item.UrunAdi</div>
                                    <p class="urun-info-icerik">@item.Icerik</p>
                                    <div class="urun-info-kalori">@item.Kalori kcal</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
    </div>
    <!-- Reservation / Contact -->
    <section class="reserve" id="rezervasyon">
        <div class="wrap">
            <div class="reserve-info">
                <span class="eyebrow">Rezervasyon &amp; İletişim</span>
                <h2 style="margin-top:0.7rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem);">Masanızı bugünden ayırtın</h2>
                <p class="measure" style="margin-top:1rem; color: var(--ink-soft);">Kalabalık gruplar ve sabahın ilk saatlerinde olacak etkinlikler için önceden haber vermenizi öneririz.</p>
                <div class="detail">@(ViewBag.Iletisim?.Adres)</div>
                <div class="detail">@(ViewBag.Iletisim?.Telefon)</div>
                <div class="detail">@(ViewBag.Iletisim?.CalismaSaatleri)</div>
            </div>
           <form class="res-form" asp-controller="Home" asp-action="RezervasyonKaydet" method="post">
    @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="field">
                        <label for="ad">Ad Soyad</label>
                        <input id="ad" name="AdSoyad" type="text" placeholder="Adınız Soyadınız" required>
                    </div>
                    <div class="field">
                        <label for="tel">Telefon</label>
                        <input id="tel" name="MusteriTelefon" type="tel" placeholder="05xx xxx xx xx" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label for="tarih">Tarih</label>
                        <input id="tarih" name="Tarih" type="date" required>
                    </div>
                    <div class="field">
                        <label for="saat">Saat</label>
                        <input id="saat" name="Saat" type="time" required>
                    </div>
                </div>
                <div class="field">
                    <label for="kisi">Kişi Sayısı</label>
                    <select id="kisi" name="KisiSayisi">
                        <option>1-2 kişi</option>
                        <option>3-4 kişi</option>
                        <option>5-8 kişi</option>
                        <option>8+ kişi</option>
                    </select>
                </div>
                <div class="field">
                    <label for="not">Not</label>
                    <textarea id="not" name="Not" placeholder="Özel bir isteğiniz varsa yazın"></textarea>
                </div>
                @if (TempData["RezervasyonBasarili"] != null)
{
    <p style="color:green; font-weight:600;">@TempData["RezervasyonBasarili"]</p>
}
                <button class="btn btn-solid" type="submit">Rezervasyonu Gönder</button>
            </form>
        </div>
    </section>
</main>

<footer class="site">
    <div class="wrap">
        <div>
            <a class="brand" href="#top" style="margin-bottom:0.9rem;">
                <svg class="brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M16 4C11 4 8 8.5 8 13c0 5.5 3.6 10 8 15 4.4-5 8-9.5 8-15 0-4.5-3-9-8-9Z" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12 13c1.5 1.8 6.5 1.8 8 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
                <span class="brand-name">Per Noi Coffee Co.</span>
            </a>
            <p style="max-width:32ch;">Ortaköy'de küçük bir kahve atölyesi ve neşeli anların ev sahibi. 2022'den beri özenle...'</p>
            <div class="socials" style="margin-top:1.25rem;">
                <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" /></svg></a>
                <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 8h2V4h-2a4 4 0 0 0-4 4v2H8v4h2v6h4v-6h2.5l.5-4H14V8Z" /></svg></a>
                <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4l16 16M20 4 4 20" /></svg></a>
            </div>
        </div>
        <div>
            <h4>Keşfet</h4>
            <ul>
                <li><a href="#hakkimizda">Hikayemiz</a></li>
                <li><a href="#menu">Menü</a></li>
                <li><a href="#galeri">Galeri</a></li>
                <li><a href="#urunler">Ürünler</a></li>
            </ul>
        </div>
        <div>
            <h4>İletişim</h4>
            <ul>
                <li>Mecidiye Mahallesi, Eski Bahçe Sokak, No: 11/B</li>
                <li>Ortaköy / İstanbul</li>
                <li>0(543) 881 85 86</li>
                <li>pelnkayaaslan@gmail.com</li>
            </ul>
        </div>
    </div>
    <div class="foot-bottom">
        <span>© 2026 PerNoiCoffeeCo. Tüm hakları saklıdır.</span>
        <span>Tasarım: YunusDincSoftware.</span>
    </div>
</footer>

<script>
    var toggle = document.getElementById('navToggle');
    var links = document.getElementById('navLinks');
    if (toggle && links) {
        toggle.addEventListener('click', function() {
            var open = links.classList.toggle('open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        links.querySelectorAll('a').forEach(function(a) {
            a.addEventListener('click', function() {
                links.classList.remove('open');
                toggle.setAttribute('aria-expanded', 'false');
            });
        });
    }

    document.querySelectorAll('.steam-line').forEach(function(el) {
        el.style.opacity = '';
    });
    document.querySelectorAll('.urun-card').forEach(function (card) {
    card.addEventListener('click', function () {
        var track = card.closest('.urunler-track');
        var zatenAktif = card.classList.contains('active');

        document.querySelectorAll('.urun-card.active').forEach(function (c) {
            c.classList.remove('active');
        });

        if (!zatenAktif) {
            card.classList.add('active');
            if (track) track.classList.add('paused');
        } else if (track) {
            track.classList.remove('paused');
        }
    });
});
</script>