<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Per Noi Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Karla:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">
                <svg class="brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M16 4C11 4 8 8.5 8 13c0 5.5 3.6 10 8 15 4.4-5 8-9.5 8-15 0-4.5-3-9-8-9Z" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12 13c1.5 1.8 6.5 1.8 8 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
                <div>
                    <div class="brand-name">Per Noi Admin</div>
                    <div class="brand-sub">Yönetim Paneli</div>
                </div>
            </div>

            <nav class="side-nav" aria-label="Yönetim menüsü">
                <div class="side-group-label">Genel</div>
                <a class="side-link" asp-controller="Home" asp-action="Index" target="_blank">
                    <svg viewBox="0 0 20 20" fill="none"><rect x="2.5" y="2.5" width="6.5" height="6.5" rx="1.3" stroke="currentColor" stroke-width="1.4" /><rect x="11" y="2.5" width="6.5" height="9.5" rx="1.3" stroke="currentColor" stroke-width="1.4" /><rect x="2.5" y="11.5" width="6.5" height="6" rx="1.3" stroke="currentColor" stroke-width="1.4" /><rect x="11" y="14.5" width="6.5" height="3" rx="1.3" stroke="currentColor" stroke-width="1.4" /></svg>
                    Siteyi Görüntüle
                </a>

                <div class="side-group-label">İçerik</div>
                <a class="side-link" asp-controller="Menus" asp-action="Index">
                    <svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4" /><path d="M6 10.3c-2.3 1.7-3.3 3.9-3.3 6.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><path d="M14 10.3c2.3 1.7 3.3 3.9 3.3 6.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><path d="M2.7 16.5h14.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                    Menü Kategorileri
                </a>
                
                <a class="side-link" asp-controller="MenuYonetim" asp-action="Index">
    <svg viewBox="0 0 20 20" fill="none"><path d="M4 3v6a3 3 0 0 0 3 3v6M7 3v6M4 3v6M13 3s3 1.4 3 5-3 5-3 5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    Menü Yönetim
</a>
                
                <a class="side-link" asp-controller="Hikayemiz" asp-action="Index">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M10 17.5s6-5 6-9.4A6 6 0 0 0 4 8.1c0 4.4 6 9.4 6 9.4Z" stroke="currentColor" stroke-width="1.4" /></svg>
                    Hikayemiz
                </a>
                <a class="side-link" asp-controller="Galeris" asp-action="Index">
                    <svg viewBox="0 0 20 20" fill="none"><rect x="2.5" y="4" width="15" height="12" rx="1.6" stroke="currentColor" stroke-width="1.4" /><circle cx="7" cy="8.4" r="1.3" stroke="currentColor" stroke-width="1.3" /><path d="M4 14l3.3-3.3a1.4 1.4 0 0 1 2 0L13 14.4M12 13l1.6-1.6a1.4 1.4 0 0 1 2 0L17.5 13.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Galeri
                </a>
                <a class="side-link" asp-controller="Urunler" asp-action="Index">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M4 3v6a3 3 0 0 0 3 3v6M7 3v6M4 3v6M13 3s3 1.4 3 5-3 5-3 5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Ürünler
                </a>
                <a class="side-link" asp-controller="Yorumlars" asp-action="Index">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M3 5.5h14v8H8.6L5 16.8V13.5H3v-8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                    Yorumlar
                </a>
                <a class="side-link" asp-controller="Iletisims" asp-action="Index">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M3 5h14v10H3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><path d="m3 5.5 7 5 7-5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                    İletişim
                </a>
            </nav>

            <div class="sidebar-foot">
                <div class="avatar">YD</div>
                <div>
                    <div class="who-name">Haşim Gider</div>
                    <div class="who-role">Yönetici</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin-left:auto;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost" style="padding:.4rem .7rem; font-size:.8rem;">Çıkış</button>
                </form>
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <div>
                    <div class="crumb">Per Noi / Admin</div>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>