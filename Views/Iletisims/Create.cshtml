@model PerNoiWebsite.Models.Iletisim

@{
    ViewData["Title"] = "Yeni Kayıt";
    Layout = "_AdminLayout";
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Yeni İletişim Kaydı</h2>
            <div class="sub">Anasayfa iletişim bölümü için içerik ekle</div>
        </div>
        <a class="btn btn-ghost" asp-action="Index">
            <svg viewBox="0 0 20 20" fill="none"><path d="M12 4 6 10l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Listeye dön
        </a>
    </div>
    <form class="form-grid" asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger span-2"></div>
        <div class="field">
            <label asp-for="Baslik">Başlık</label>
            <input asp-for="Baslik" />
            <span asp-validation-for="Baslik" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="Telefon">Telefon</label>
            <input asp-for="Telefon" class="mono" placeholder="0212 000 00 00" />
            <span asp-validation-for="Telefon" class="text-danger"></span>
        </div>
        <div class="field span-2">
            <label asp-for="AltMetin">Alt Metin</label>
            <textarea asp-for="AltMetin"></textarea>
            <span asp-validation-for="AltMetin" class="text-danger"></span>
        </div>
        <div class="field span-2">
            <label asp-for="Adres">Adres</label>
            <textarea asp-for="Adres"></textarea>
            <span asp-validation-for="Adres" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="CalismaSaatleri">Çalışma Saatleri</label>
            <input asp-for="CalismaSaatleri" placeholder="Örn. Her gün 08:00 - 22:00" />
            <span asp-validation-for="CalismaSaatleri" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <a class="btn btn-ghost" asp-action="Index">Vazgeç</a>
            <button class="btn btn-primary" type="submit">Kaydet</button>
        </div>
    </form>
</div>