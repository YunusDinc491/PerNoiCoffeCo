@model IEnumerable<PerNoiWebsite.Models.Menu>

@{
    ViewData["Title"] = "Index";
    Layout = "_AdminLayout";
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Menü Kategorileri</h2>
            <div class="sub">Kahveler, Çaylar ve Diğerleri, Atıştırmalıklar gibi üst kategoriler</div>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <svg viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            Yeni Kategori
        </a>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Kategori</th><th>Ürün Sayısı</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><div class="cell-name">@item.Baslik</div></td>
                        <td class="mono">@(item.CaylarVeDigerleri?.Count ?? 0)</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" aria-label="Düzenle"><svg viewBox="0 0 20 20" fill="none"><path d="m13.4 3.6 3 3L7 16H4v-3l9.4-9.4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg></a>
                                <a class="danger" asp-action="Delete" asp-route-id="@item.Id" aria-label="Sil"><svg viewBox="0 0 20 20" fill="none"><path d="M4.5 6h11M8.3 6V4.4h3.4V6M6 6l.6 9.4a1 1 0 0 0 1 1h4.8a1 1 0 0 0 1-1L14 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

