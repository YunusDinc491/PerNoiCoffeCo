@model PerNoiWebsite.Models.Yorumlar

@{
    ViewData["Title"] = "Yorumu Düzenle";
    Layout = "_AdminLayout";
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Yorumu Düzenle</h2>
            <div class="sub">@Model.KisiAdi</div>
        </div>
        <a class="btn btn-ghost" asp-action="Index">
            <svg viewBox="0 0 20 20" fill="none"><path d="M12 4 6 10l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Listeye dön
        </a>
    </div>
    <form class="form-grid" asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger span-2"></div>
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label asp-for="KisiAdi">Kişi Adı</label>
            <input asp-for="KisiAdi" />
            <span asp-validation-for="KisiAdi" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="Lakap">Lakap / Ünvan</label>
            <input asp-for="Lakap" />
            <span asp-validation-for="Lakap" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="Baslik">Başlık</label>
            <input asp-for="Baslik" />
            <span asp-validation-for="Baslik" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="Photo">Fotoğraf</label>
            <input asp-for="Photo" class="mono" />
            <span asp-validation-for="Photo" class="text-danger"></span>
        </div>
        <div class="field span-2">
            <label asp-for="Yorum">Yorum</label>
            <textarea asp-for="Yorum"></textarea>
            <span asp-validation-for="Yorum" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <a class="btn btn-ghost" asp-action="Index">Vazgeç</a>
            <button class="btn btn-primary" type="submit">Değişiklikleri Kaydet</button>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}