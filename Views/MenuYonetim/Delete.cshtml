@model PerNoiWebsite.Models.MenuCaylarveDigerleri

@{
    ViewData["Title"] = "Ürünü Sil";
    Layout = "_AdminLayout";
}

<div class="panel">
    <div class="panel-head">
        <div>
            <h2>Bu ürünü silmek istediğine emin misin?</h2>
            <div class="sub">Bu işlem geri alınamaz</div>
        </div>
        <a class="btn btn-ghost" asp-action="Index">
            <svg viewBox="0 0 20 20" fill="none"><path d="M12 4 6 10l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Listeye dön
        </a>
    </div>
    <div class="form-grid">
        <div class="field">
            <label>Ürün Adı</label>
            <div>@Html.DisplayFor(model => model.IcecekAdi)</div>
        </div>
        <div class="field">
            <label>Fiyat</label>
            <div class="mono">₺@Html.DisplayFor(model => model.Fiyat)</div>
        </div>
        <div class="field span-2">
            <label>Açıklama</label>
            <div>@Html.DisplayFor(model => model.Aciklama)</div>
        </div>
        <form asp-action="Delete" class="form-actions span-2">
            <input type="hidden" asp-for="Id" />
            <a class="btn btn-ghost" asp-action="Index">Vazgeç</a>
            <button type="submit" class="btn btn-primary" style="background:var(--bad); color:#fff;">Evet, Sil</button>
        </form>
    </div>
</div>